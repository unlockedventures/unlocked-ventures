# =============================================================================
# Local machine only (any developer laptop)
# =============================================================================
#   cp .env.example .env
#   docker compose up -d --build
#     → keep DATABASE_URL host as "db"
#   OR pnpm with Postgres on the host
#     → change host "db" to "127.0.0.1"
#
# Empty Postgres = blank/broken localhost:3000 until you import a DB+media archive
# (scripts/import-db.sh) or create CMS schema/content another way. Compose "healthy"
# only means processes are up — not that the homepage has content.
#
# Not used for VPS production. Production env is written by GitHub Actions
# from repository Secrets. Do not put IONOS_* here. Never commit .env.
# =============================================================================

# Compose service hostname "db". Swap to 127.0.0.1 for host-based pnpm + local Postgres.
DATABASE_URL=postgresql://payload:payload@db:5432/unlocked_ventures

# Dummy local secrets — fine for Compose boot; replace with your own if you like.
PAYLOAD_SECRET=local-dev-payload-secret-change-me-32b
TRANSCRIBER_SECRET=local-dev-transcriber-secret-change-me-32b

# Use your own Gemini key for AI/podcast features. Dummy value boots the site shell.
GEMINI_API_KEY=AIzaSyDummyLocalDevKeyReplaceMe000000

# Browser origin for local work (no trailing slash).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Host bind mounts (persist across `docker compose up/down`; not removed unless you
# delete these folders or run `docker compose down -v`). Later you can replace/import
# DB+media into these paths, or point the vars at other directories you mount.
#   UV_DATA_DIR/postgres  → Postgres data
#   UV_MEDIA_DIR          → Payload uploads
# (VPS uses /var/lib/unlocked-venture — keep ./data and ./media on laptops.)
UV_DATA_DIR=./data
UV_MEDIA_DIR=./media

# Injected/used with Compose services on network unlocked-venture.
KOKORO_BASE_URL=http://kokoro:8880

WHISPER_MODEL=small
TRANSCRIBER_TIMEOUT_SECONDS=43200
GENERATION_LOCK_HOURS=12
KOKORO_TIMEOUT_MS=1800000
ENSURE_SCHEMA_STRICT=0

# Optional local SMTP (otherwise contact mail logs to console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=dev@example.com
# SMTP_PASS=dummy-smtp-password
# SMTP_FROM_ADDRESS=noreply@example.com
# SMTP_FROM_NAME=Unlocked Ventures
# SMTP_SKIP_VERIFY=true
