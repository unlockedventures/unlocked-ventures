# Placeholders only. Copy to .env for local `docker compose up -d`.
# On IONOS, GitHub Actions writes .env from repo secrets (never commit real values).
DATABASE_URL=postgresql://payload:payload@db:5432/unlocked_ventures
PAYLOAD_SECRET=replace-with-a-long-random-string
TRANSCRIBER_SECRET=replace-with-a-long-random-string
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Host folders (survive image/container rebuilds).
# UV_DATA_DIR=./data              # postgres + whisper caches (VPS: /var/lib/unlocked-venture)
# UV_MEDIA_DIR=./media            # Payload uploads (VPS: /var/lib/unlocked-venture/media)
# Optional override; default is gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.1-flash-lite
# Compose sets TRANSCRIBER_URL=http://whisper:8080 and KOKORO_BASE_URL=http://kokoro:8880 on app.
KOKORO_BASE_URL=http://kokoro:8880
# Optional Kokoro overrides.
# KOKORO_MODEL=kokoro
# KOKORO_SPEED=1
# Per-turn TTS timeout (ms). App default 120000; production Compose sets 1800000.
# KOKORO_TIMEOUT_MS=1800000
# Whisper model (docker-compose default: small). Do not use turbo on an 8 GB VPS shared with the app.
# WHISPER_MODEL=small
# Transcription wall-clock (seconds). App/whisper default 1800; production Compose sets 43200 (12h).
# TRANSCRIBER_TIMEOUT_SECONDS=43200
# Generation lease hours if a worker crashes. App default 1; production Compose sets 12.
# GENERATION_LOCK_HOURS=12
# Public site origin used by robots.txt, sitemap.xml, and metadataBase (no trailing slash).
# NEXT_PUBLIC_SERVER_URL=https://unlocked-ventures.vercel.app
# Optional SMTP for contact-form owner emails (without these, Payload logs emails to the console).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=noreply@unlockedventures.com
# SMTP_FROM_NAME=Unlocked Ventures
# SMTP_SKIP_VERIFY=true
