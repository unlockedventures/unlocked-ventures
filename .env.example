# =============================================================================
# Local developer environment (copy to .env — never commit .env)
# =============================================================================
#   cp .env.example .env
#   # edit placeholders below, then either:
#   docker compose up -d --build          # full stack (db + whisper + kokoro + app)
#   # or pnpm against a local Postgres     # see README.md “Develop locally”
#
# Production on the VPS does NOT use this file from Git. GitHub Actions writes the
# server .env from repository Secrets (IONOS_*, DATABASE_URL, …). Developers do
# not need those Actions secrets to run locally.
# =============================================================================

# --- Required (app will not start without these) ------------------------------
# Docker Compose: host MUST be "db" (service name on network unlocked-venture).
# pnpm on the host with Postgres on your machine: use 127.0.0.1 instead of db.
DATABASE_URL=postgresql://payload:payload@db:5432/unlocked_ventures

# Long random strings — generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string
TRANSCRIBER_SECRET=replace-with-a-long-random-string

# Gemini key for podcast / AI generation features (get one from Google AI Studio).
# Site shell can boot without a real key; generation features need a valid value.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Public origin for metadata / sitemap / absolute URLs (no trailing slash).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Local durable folders (survive container rebuilds) -----------------------
# Defaults match docker-compose.yml. Do not point these at production VPS paths.
UV_DATA_DIR=./data
UV_MEDIA_DIR=./media

# --- Wired by Compose for the app (safe to keep in .env for clarity) ----------
KOKORO_BASE_URL=http://kokoro:8880
# TRANSCRIBER_URL is injected by Compose as http://whisper:8080

# --- Sensible local / Compose defaults (optional overrides) -------------------
WHISPER_MODEL=small
# Keep small on modest laptops; do not use turbo on an 8 GB shared box.
TRANSCRIBER_TIMEOUT_SECONDS=43200
GENERATION_LOCK_HOURS=12
KOKORO_TIMEOUT_MS=1800000
# Local empty DB: leave 0 so boot is non-fatal. Production Actions sets 1.
ENSURE_SCHEMA_STRICT=0

# --- Optional model / TTS tweaks ----------------------------------------------
# GEMINI_MODEL=gemini-3.1-flash-lite
# KOKORO_MODEL=kokoro
# KOKORO_SPEED=1

# --- Optional SMTP (contact form). Without these, email goes to console logs. -
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=noreply@example.com
# SMTP_FROM_NAME=Unlocked Ventures
# SMTP_SKIP_VERIFY=true

# --- Not for local .env (GitHub Actions / VPS only) ---------------------------
# IONOS_HOST, IONOS_SSH_USER, IONOS_SSH_PRIVATE_KEY, IONOS_APP_PATH
# (and production overrides of the variables above) live in repo Actions Secrets.
