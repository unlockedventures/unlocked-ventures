# dependencies
/node_modules
/.pnp
.pnp.js
.pnpm-store
.yarn/install-state.gz

# secrets and local environment
# Real values come from GitHub Actions / Jenkins / VPS secrets at deploy time.
# Commit only .env.example (placeholders). Never commit .env or secret files.
.env
.env.*
!.env.example
*.pem
*.key
!*.key.pub
credentials.json
secrets/
*.secret

# local Compose overrides (may contain host-specific or secret wiring)
docker-compose.override.yml
compose.override.yml

# Local-only deploy AI context for Cursor/Claude (never commit)
/automation/

# database / upload archives — never push media dumps to GitHub
/backups/
*.dump
*.sql.gz
*.tar.gz
unlocked-ventures-*.tar.gz

# next.js
/.next/
/out/
next-env.d.ts

# payload uploads and generated audio on disk — never commit / never push to GitHub
/media
/media/**
/media.before-import.*
/podcast-audio
/podcast-audio/**

# Compose bind-mount data root (postgres + media + whisper caches)
/data/

# VPS deploy rollback metadata (images refs, git sha, env bak)
.deploy-rollback/

# typescript
*.tsbuildinfo

# test and coverage output
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# local tooling
/.idea/*
!/.idea/runConfigurations
.superpowers/
tmp/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# production
/build

# vercel
.vercel

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

# misc
.DS_Store
Thumbs.db

# BEGIN AI-DLC:gitignore
# AI-DLC: local working files
aidlc/active-space
aidlc/spaces/*/intents/active-intent
aidlc/.aidlc-clone-id
aidlc.settings.local.json
aidlc/.aidlc-unit-scope.json
aidlc/.aidlc-unit-parked
aidlc/.aidlc-claim-generations.json
aidlc/.aidlc-unit-participant
aidlc/.aidlc-claim-registry.json
aidlc/.aidlc-unit-releases/
aidlc/.aidlc-unit-merges/
aidlc/.aidlc-active-space-*.tmp
aidlc/.aidlc-sessions/
aidlc/spaces/*/intents/.aidlc-*
**/aidlc/spaces/*/intents/**/.aidlc-engine/
**/aidlc/spaces/*/intents/**/.aidlc-sensors/
aidlc/spaces/*/knowledge/documentkb/.journal/
aidlc/spaces/*/knowledge/.sources.local.json
aidlc/spaces/*/intents/*/runtime-graph.json
aidlc/spaces/*/intents/*/.aidlc-*
aidlc/diagnostics/
aidlc/.aidlc-cursor-subagents/
aidlc/.aidlc-cursor-subagent-*.json
# END AI-DLC:gitignore
